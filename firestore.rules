rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/users/$(uid)/viewerEmails/default) &&
        request.auth.token.email in
          get(/databases/$(database)/documents/users/$(uid)/viewerEmails/default).data.emails;
    }
    match /viewerIndex/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow create, update: if request.auth != null &&
        request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null &&
        (resource.data.ownerUid == request.auth.uid || request.auth.token.email == email);
    }
  }
}
